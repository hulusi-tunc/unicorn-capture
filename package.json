{
	"name": "@unicorn-studio/capture",
	"version": "0.0.1",
	"description": "Unicorn Capture — desktop snap tool that auto-categorizes screens by route/state/session for the Unicorn Studio gallery platform. Forked from Prisma.",
	"type": "module",
	"scripts": {
		"start": "electrobun dev",
		"dev": "electrobun dev --watch",
		"snap": "bun src/bun/cli.ts",
		"build": "electrobun build",
		"build:canary": "electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable",
		"build:signed": "bash -c 'set -a; [ -f .env.build ] && source .env.build; set +a; electrobun build --env=stable'",
		"release:publish": "bash scripts/publish-release.sh",
		"release:publish:canary": "bash scripts/publish-release.sh canary",
		"release:publish:stable": "bash scripts/publish-release.sh stable",
		"release": "bun run build:signed && bun run release:publish:stable",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"ci": "biome check src/ && electrobun build"
	},
	"dependencies": {
		"electrobun": "^1.18.1",
		"js-yaml": "^4.1.0",
		"lucide": "^1.14.0",
		"pngjs": "^7.0.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "^1.3.8",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.0.0",
		"@types/pngjs": "^6.0.5"
	}
}
