# Build-time env vars for `bun run build:signed`. Copy to .env.build (which
# IS in .gitignore) and fill in. Loaded via `source .env.build` so the
# electrobun build picks them up.

# ─── Codesign ─────────────────────────────────────────────────────────────
# Full identity string from `security find-identity -v -p codesigning`.
# Must be a "Developer ID Application: …" line (NOT "Apple Development" or
# "Apple Distribution" — those won't pass Gatekeeper outside dev/App Store).
ELECTROBUN_DEVELOPER_ID="Developer ID Application: Cobepal (XXXXXXXXXX)"

# ─── Notarize (Apple ID path; alternative: API key path) ──────────────────
# App-specific password — generate at appleid.apple.com → Sign-In and
# Security → App-Specific Passwords. NOT your account password.
ELECTROBUN_APPLEID="hulusitunc1@gmail.com"
ELECTROBUN_APPLEIDPASS="abcd-efgh-ijkl-mnop"
ELECTROBUN_TEAMID="XXXXXXXXXX"

# Alternative: API key (more robust for CI). If set, takes precedence over
# Apple ID path. App Store Connect → Users and Access → Keys → "+".
# ELECTROBUN_APPLEAPIKEYPATH="/path/to/AuthKey_XXX.p8"
# ELECTROBUN_APPLEAPIKEY="XXXXXXXXXX"
# ELECTROBUN_APPLEAPIISSUER="00000000-0000-0000-0000-000000000000"

# ─── Auto-update: where the running app polls for fresh artifacts ────────
# Public-facing URL. Whatever path you serve from (rsync host, S3 public
# bucket, Cloudflare R2 with public domain, Vercel project) put the URL
# here. Example: "https://capture-releases.unicornstudio.com" — the app
# fetches `<URL>/canary-macos-arm64-update.json` etc.
ELECTROBUN_RELEASE_BASE_URL=""

# ─── Auto-update: where to UPLOAD artifacts ──────────────────────────────
# Pick one. The publish-release.sh script reads these.

# Option 1 — rsync (works for any SSH-reachable host):
# PUBLISH_RSYNC_DEST="user@host:/var/www/capture-releases"

# Option 2 — S3 / R2 / Backblaze (requires `aws` CLI in PATH):
# PUBLISH_S3_BUCKET="unicorn-capture-releases"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_ENDPOINT_URL_S3="..."  # only for non-AWS S3 (R2, Backblaze)
